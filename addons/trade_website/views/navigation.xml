<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Menu *entities* only — no parent_id / website_id here on purpose.

        Why: Odoo renders each website's navigation from that website's
        own "Top Menu for Website N" record (website.menu_id). A menu
        written with a fixed parent in XML would be reset on every module
        upgrade, dropping the hierarchy back to root nodes.

        So the hierarchy is owned by XML ID in addons/trade_website/hooks.py
        (configure_navigation), wired by:
          * post_init_hook          — fresh install
          * migrations/19.0.1.0.5   — existing DB upgrade

        noupdate="1" keeps these records stable across upgrades: the XML
        no longer re-creates them as root nodes, and the migration flips
        ir.model.data noupdate=True so future upgrades never strip the
        parent_id it sets.

        Never build the tree by searching menu `name` — that field is
        translatable and unstable.
    -->

    <data noupdate="1">

    <!-- Top-level conceptual groups -->
    <record id="menu_products" model="website.menu">
        <field name="name">Products</field>
        <field name="url">/products</field>
        <field name="sequence" type="int">20</field>
    </record>

    <record id="menu_solution" model="website.menu">
        <field name="name">Our Solution</field>
        <field name="url">/solution</field>
        <field name="sequence" type="int">30</field>
    </record>

    <record id="menu_about" model="website.menu">
        <field name="name">About</field>
        <field name="url">/about-us</field>
        <field name="sequence" type="int">50</field>
    </record>

    <record id="menu_request_quote" model="website.menu">
        <field name="name">Request a Quote</field>
        <field name="url">/request-quote</field>
        <field name="sequence" type="int">80</field>
    </record>

    <!-- Products children -->
    <record id="menu_products_all" model="website.menu">
        <field name="name">All Products</field>
        <field name="url">/products</field>
        <field name="sequence" type="int">21</field>
    </record>

    <record id="menu_product_air_duster" model="website.menu">
        <field name="name">Cordless Air Duster</field>
        <field name="url">/products/cordless-air-duster</field>
        <field name="sequence" type="int">22</field>
    </record>

    <record id="menu_product_instant_camera" model="website.menu">
        <field name="name">Instant Print Camera</field>
        <field name="url">/products/instant-print-camera</field>
        <field name="sequence" type="int">23</field>
    </record>

    <record id="menu_product_ultrasonic_cutter" model="website.menu">
        <field name="name">Ultrasonic Cutter</field>
        <field name="url">/products/ultrasonic-cutter</field>
        <field name="sequence" type="int">24</field>
    </record>

    <!-- Our Solution children -->
    <record id="menu_solution_overview" model="website.menu">
        <field name="name">Overview</field>
        <field name="url">/solution</field>
        <field name="sequence" type="int">31</field>
    </record>

    <record id="menu_manufacturing" model="website.menu">
        <field name="name">Manufacturing Control</field>
        <field name="url">/manufacturing</field>
        <field name="sequence" type="int">32</field>
    </record>

    <record id="menu_quality" model="website.menu">
        <field name="name">Quality &amp; Documentation</field>
        <field name="url">/quality</field>
        <field name="sequence" type="int">33</field>
    </record>

    <record id="menu_our_advantage" model="website.menu">
        <field name="name">Product Selection Focus</field>
        <field name="url">/our-advantage</field>
        <field name="sequence" type="int">34</field>
    </record>

    <!-- About children -->
    <record id="menu_about_us" model="website.menu">
        <field name="name">About Us</field>
        <field name="url">/about-us</field>
        <field name="sequence" type="int">51</field>
    </record>

    </data>

</odoo>