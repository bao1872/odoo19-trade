<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Inherit the official Odoo 19 homepage (website.homepage).
        v0.4: 5 main visual sections (no hero small-block collage, no
        separate Capabilities / Compliance / How-We-Work section — those
        contents moved into /solution).
    -->
    <template
        id="trade_homepage"
        name="Trade Homepage"
        inherit_id="website.homepage"
    >

        <xpath expr="//div[@id='wrap']" position="replace">

            <div id="wrap" class="oe_structure trade-site trade-home">

                <!-- ============================================== -->
                <!-- 1. HERO                                        -->
                <!-- ============================================== -->
                <section class="trade-hero">
                    <div class="container">
                        <div class="row align-items-center g-4 trade-hero-grid">

                            <div class="col-lg-5 trade-hero-copy-col">
                                <div class="trade-eyebrow">
                                    YOUR SOURCING AND MANUFACTURING PARTNER
                                </div>

                                <h1 class="trade-hero-title">
                                    China Manufacturing.<br/>
                                    <span>U.S. Market Execution.</span>
                                </h1>

                                <p class="trade-hero-copy">
                                    We source, validate and deliver
                                    market-ready products from selected
                                    Chinese manufacturers, coordinating
                                    specifications, samples, production,
                                    quality, customization and shipment.
                                </p>

                                <div class="trade-actions">
                                    <a href="/request-quote"
                                       class="btn trade-btn-primary">
                                        Request a Quote
                                    </a>
                                    <a href="/products"
                                       class="btn trade-btn-secondary">
                                        Explore Our Products
                                    </a>
                                </div>
                            </div>

                            <div class="col-lg-7 trade-hero-visual-col">
                                <div class="trade-visual trade-visual-hero">
                                    <img
                                        src="/trade_website/static/src/img/v04/homepage/hero-product-stage.webp"
                                        alt="Cordless Air Duster, Instant Print Camera and Ultrasonic Cutter on a presentation stage"/>
                                </div>
                            </div>

                        </div>
                    </div>
                </section>


                <!-- ============================================== -->
                <!-- 2. CONTROL STRIP                               -->
                <!-- ============================================== -->
                <section class="trade-control-strip">
                    <div class="container">
                        <div class="row g-4">

                            <div class="col-md-6 col-lg-3">
                                <div class="trade-control-item">
                                    <span class="trade-control-icon"
                                          aria-hidden="true">
                                        <svg viewBox="0 0 24 24"
                                             width="22" height="22"
                                             fill="none"
                                             stroke="currentColor"
                                             stroke-width="1.6">
                                            <path d="M3 21V9l9-6 9 6v12"/>
                                            <path d="M9 21v-7h6v7"/>
                                        </svg>
                                    </span>
                                    <div>
                                        <strong>Direct Factory Access</strong>
                                        <span>
                                            Work with selected manufacturing
                                            partners.
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6 col-lg-3">
                                <div class="trade-control-item">
                                    <span class="trade-control-icon"
                                          aria-hidden="true">
                                        <svg viewBox="0 0 24 24"
                                             width="22" height="22"
                                             fill="none"
                                             stroke="currentColor"
                                             stroke-width="1.6">
                                            <path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6l8-3z"/>
                                            <path d="M9 12l2 2 4-4"/>
                                        </svg>
                                    </span>
                                    <div>
                                        <strong>Quality Checkpoints</strong>
                                        <span>
                                            Defined inspection points from
                                            sample to shipment.
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6 col-lg-3">
                                <div class="trade-control-item">
                                    <span class="trade-control-icon"
                                          aria-hidden="true">
                                        <svg viewBox="0 0 24 24"
                                             width="22" height="22"
                                             fill="none"
                                             stroke="currentColor"
                                             stroke-width="1.6">
                                            <path d="M12 3l9 5-9 5-9-5 9-5z"/>
                                            <path d="M3 13l9 5 9-5"/>
                                        </svg>
                                    </span>
                                    <div>
                                        <strong>OEM / Private Label</strong>
                                        <span>
                                            Logo, packaging and product
                                            customization.
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6 col-lg-3">
                                <div class="trade-control-item">
                                    <span class="trade-control-icon"
                                          aria-hidden="true">
                                        <svg viewBox="0 0 24 24"
                                             width="22" height="22"
                                             fill="none"
                                             stroke="currentColor"
                                             stroke-width="1.6">
                                            <path d="M3 7h11v9H3z"/>
                                            <path d="M14 10h4l3 3v3h-7z"/>
                                            <circle cx="7" cy="18" r="2"/>
                                            <circle cx="17" cy="18" r="2"/>
                                        </svg>
                                    </span>
                                    <div>
                                        <strong>Delivery Coordination</strong>
                                        <span>
                                            Production follow-up and
                                            U.S.-bound logistics.
                                        </span>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </section>


                <!-- ============================================== -->
                <!-- 3. FEATURED PRODUCTS                            -->
                <!-- ============================================== -->
                <section id="products" class="trade-section trade-products">

                    <div class="container">

                        <div class="trade-products-head">
                            <div>
                                <h2 class="trade-section-title">Featured Products</h2>
                                <p class="trade-section-sub">
                                    Selected products for U.S. market
                                    evaluation and B2B sourcing programs.
                                </p>
                            </div>
                            <a href="/products" class="trade-link">
                                View All Products
                            </a>
                        </div>

                        <div class="row g-4">

                            <div class="col-md-6 col-xl-4">
                                <article class="trade-product-card">
                                    <div class="trade-visual trade-visual-product">
                                        <img loading="lazy"
                                             src="/trade_website/static/src/img/v04/products/air-duster.webp"
                                             alt="Cordless Air Duster with nozzles"/>
                                    </div>
                                    <div class="trade-product-body">
                                        <span class="trade-product-cat">
                                            Cleaning &amp; Maintenance
                                        </span>
                                        <h3>Cordless Air Duster</h3>
                                        <p>
                                            Clean More.
                                            Worry Less.
                                        </p>
                                        <div class="trade-tags">
                                            <span class="trade-tag">Cordless</span>
                                            <span class="trade-tag">OEM</span>
                                            <span class="trade-tag">
                                                Multi-Nozzle
                                            </span>
                                        </div>
                                        <a class="trade-link"
                                           href="/products/cordless-air-duster">
                                            View Product
                                        </a>
                                    </div>
                                </article>
                            </div>

                            <div class="col-md-6 col-xl-4">
                                <article class="trade-product-card">
                                    <div class="trade-visual trade-visual-product">
                                        <img loading="lazy"
                                             src="/trade_website/static/src/img/v04/products/instant-print-camera.webp"
                                             alt="Instant Print Camera printing a photo"/>
                                    </div>
                                    <div class="trade-product-body">
                                        <span class="trade-product-cat">
                                            Consumer Electronics
                                        </span>
                                        <h3>Instant Print Camera</h3>
                                        <p>
                                            Capture Moments.
                                            Print Happiness.
                                        </p>
                                        <div class="trade-tags">
                                            <span class="trade-tag">
                                                Instant Print
                                            </span>
                                            <span class="trade-tag">
                                                Private Label
                                            </span>
                                            <span class="trade-tag">
                                                Gift &amp; Lifestyle
                                            </span>
                                        </div>
                                        <a class="trade-link"
                                           href="/products/instant-print-camera">
                                            View Product
                                        </a>
                                    </div>
                                </article>
                            </div>

                            <div class="col-md-6 col-xl-4">
                                <article class="trade-product-card">
                                    <div class="trade-visual trade-visual-product">
                                        <img loading="lazy"
                                             src="/trade_website/static/src/img/v04/products/ultrasonic-cutter.webp"
                                             alt="Ultrasonic Cutter"/>
                                    </div>
                                    <div class="trade-product-body">
                                        <span class="trade-product-cat">
                                            Tools &amp; Equipment
                                        </span>
                                        <h3>Ultrasonic Cutter</h3>
                                        <p>
                                            Precision Tools
                                            for Creative Ideas.
                                        </p>
                                        <div class="trade-tags">
                                            <span class="trade-tag">
                                                Precision Tool
                                            </span>
                                            <span class="trade-tag">
                                                Replaceable Blade
                                            </span>
                                            <span class="trade-tag">OEM</span>
                                        </div>
                                        <a class="trade-link"
                                           href="/products/ultrasonic-cutter">
                                            View Product
                                        </a>
                                    </div>
                                </article>
                            </div>

                        </div>
                    </div>
                </section>


                <!-- ============================================== -->
                <!-- 4. OUR MANUFACTURING SOLUTION (dark navy)       -->
                <!-- ============================================== -->
                <section class="trade-section trade-solution-strip">

                    <div class="container">
                        <div class="row g-4 align-items-center">

                            <div class="col-lg-5">
                                <div class="trade-eyebrow trade-eyebrow-light">
                                    OUR MANUFACTURING SOLUTION
                                </div>
                                <h2 class="trade-solution-title">
                                    More Than Product Sourcing.<br/>
                                    A Controlled Supply Process.
                                </h2>
                                <p class="trade-solution-copy">
                                    We coordinate critical steps between
                                    product selection and shipment — so
                                    every product is supported by a
                                    defined process on the factory side.
                                </p>
                                <a href="/solution" class="trade-link trade-link-light">
                                    Explore Our Solution
                                </a>
                            </div>

                            <div class="col-lg-7">
                                <div class="trade-solution-tiles">

                                    <div class="trade-solution-tile">
                                        <div class="trade-visual trade-visual-process">
                                            <img loading="lazy"
                                                 src="/trade_website/static/src/img/v04/process/01-product-alignment.webp"
                                                 alt="Product and factory alignment"/>
                                        </div>
                                        <span class="trade-solution-tile-label">
                                            Factory Alignment
                                        </span>
                                    </div>

                                    <div class="trade-solution-tile">
                                        <div class="trade-visual trade-visual-process">
                                            <img loading="lazy"
                                                 src="/trade_website/static/src/img/v04/process/02-sample-validation.webp"
                                                 alt="Sample validation"/>
                                        </div>
                                        <span class="trade-solution-tile-label">
                                            Sample Validation
                                        </span>
                                    </div>

                                    <div class="trade-solution-tile">
                                        <div class="trade-visual trade-visual-process">
                                            <img loading="lazy"
                                                 src="/trade_website/static/src/img/v04/process/05-quality-checkpoints.webp"
                                                 alt="Quality checkpoints"/>
                                        </div>
                                        <span class="trade-solution-tile-label">
                                            Quality Checkpoints
                                        </span>
                                    </div>

                                    <div class="trade-solution-tile">
                                        <div class="trade-visual trade-visual-process">
                                            <img loading="lazy"
                                                 src="/trade_website/static/src/img/v04/process/06-shipment-preparation.webp"
                                                 alt="Shipping preparation"/>
                                        </div>
                                        <span class="trade-solution-tile-label">
                                            Shipping Preparation
                                        </span>
                                    </div>

                                </div>
                            </div>

                        </div>
                    </div>
                </section>


                <!-- ============================================== -->
                <!-- 5. WHY U.S. BUSINESSES WORK WITH US + CTA       -->
                <!-- ============================================== -->
                <section class="trade-section trade-advantage-cta">

                    <div class="container">
                        <div class="row g-4 align-items-stretch">

                            <div class="col-lg-7">
                                <div class="trade-eyebrow">
                                    WHY U.S. BUSINESSES WORK WITH US
                                </div>
                                <h2 class="trade-block-title">
                                    From Good Products to
                                    Great Opportunities.
                                </h2>

                                <div class="trade-advantage-list">

                                    <div class="trade-advantage-item">
                                        <strong>Focus on Real Opportunities</strong>
                                        <span>
                                            Selected products, not endless
                                            catalogs. We focus on a limited
                                            set of products where
                                            manufacturing capability,
                                            customization flexibility and
                                            market fit justify deeper
                                            evaluation.
                                        </span>
                                    </div>

                                    <div class="trade-advantage-item">
                                        <strong>Factory-Side Coordination</strong>
                                        <span>
                                            Direct communication across
                                            critical manufacturing steps —
                                            specifications, samples,
                                            customization and production
                                            follow-up.
                                        </span>
                                    </div>

                                    <div class="trade-advantage-item">
                                        <strong>U.S. Market Readiness</strong>
                                        <span>
                                            Product, packaging and
                                            documentation reviewed with
                                            destination requirements in
                                            mind.
                                        </span>
                                    </div>

                                </div>
                            </div>

                            <div class="col-lg-5">
                                <div class="trade-cta trade-cta-tile">
                                    <div class="trade-cta-inner">
                                        <h2>
                                            Ready to Start Your
                                            Next Project?
                                        </h2>
                                        <p>
                                            Tell us what you are looking
                                            for. We will review product,
                                            factory and customization
                                            options.
                                        </p>
                                        <div class="trade-actions trade-actions-center">
                                            <a href="/request-quote"
                                               class="btn trade-btn-primary">
                                                Request a Quote
                                            </a>
                                            <a href="/contactus"
                                               class="btn trade-btn-ghost">
                                                Contact Us
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </section>

            </div>

        </xpath>

    </template>

</odoo>