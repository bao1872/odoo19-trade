    <!-- ============================================================= -->
    <!-- /products — product index                                      -->
    <!-- ============================================================= -->
    <template id="products_index" name="Selected Products">

        <t t-call="website.layout">

            <t t-set="additional_title">Selected Products</t>

            <div id="wrap" class="oe_structure trade-site trade-products-index">

                <section class="trade-page-hero">
                    <div class="container">
                        <div class="trade-eyebrow">PRODUCTS</div>
                        <h1 class="trade-page-title">Selected Products</h1>
                        <p class="trade-page-lead">
                            Products selected for U.S. market evaluation and
                            B2B sourcing programs.
                        </p>
                    </div>
                </section>

                <section class="trade-section">
                    <div class="container">
                        <div class="row g-4">

                            <div class="col-md-6 col-lg-4">
                                <article class="trade-product-card">
                                    <div class="trade-product-media trade-placeholder-flat">
                                        Product Image
                                    </div>
                                    <div class="trade-product-body">
                                        <h3>Cordless Air Duster</h3>
                                        <p>
                                            Reusable air cleaning solution for
                                            electronics, automotive and
                                            workspace applications.
                                        </p>
                                        <span class="trade-tag">
                                            OEM / Private Label
                                        </span>
                                        <a class="trade-link"
                                           href="/products/cordless-air-duster">
                                            View Product
                                        </a>
                                    </div>
                                </article>
                            </div>

                            <div class="col-md-6 col-lg-4">
                                <article class="trade-product-card">
                                    <div class="trade-product-media trade-placeholder-flat">
                                        Product Image
                                    </div>
                                    <div class="trade-product-body">
                                        <h3>Instant Print Camera</h3>
                                        <p>
                                            Compact instant-print platform for
                                            gift, lifestyle and private-label
                                            programs.
                                        </p>
                                        <span class="trade-tag">Private Label</span>
                                        <a class="trade-link"
                                           href="/products/instant-print-camera">
                                            View Product
                                        </a>
                                    </div>
                                </article>
                            </div>

                            <div class="col-md-6 col-lg-4">
                                <article class="trade-product-card">
                                    <div class="trade-product-media trade-placeholder-flat">
                                        Product Image
                                    </div>
                                    <div class="trade-product-body">
                                        <h3>Ultrasonic Cutter</h3>
                                        <p>
                                            Precision cutting tool platform for
                                            workshop, craft and light
                                            fabrication applications.
                                        </p>
                                        <span class="trade-tag">OEM Available</span>
                                        <a class="trade-link"
                                           href="/products/ultrasonic-cutter">
                                            View Product
                                        </a>
                                    </div>
                                </article>
                            </div>

                        </div>
                    </div>
                </section>

                <section class="trade-cta">
                    <div class="container">
                        <div class="trade-cta-inner">
                            <h2>Need a Product That Is Not Listed?</h2>
                            <p>
                                Tell us the product category, target
                                specification and quantity. We will review
                                sourcing and factory options.
                            </p>
                            <div class="trade-actions trade-actions-center">
                                <a href="/request-quote"
                                   class="btn trade-btn-primary">
                                    Request a Quote
                                </a>
                            </div>
                        </div>
                    </div>
                </section>

            </div>

        </t>

    </template>

    <record id="products_index_page" model="website.page">
        <field name="name">Selected Products</field>
        <field name="url">/products</field>
        <field name="is_published" eval="True"/>
        <field name="view_id" ref="products_index"/>
    </record>


